# API base URL of porokh-backend, ending in /api/v1.
# Android emulator: use http://10.0.2.2:5000/api/v1 instead of 127.0.0.1.
VITE_API_URL=http://127.0.0.1:5000/api/v1

# Set the intended Supabase project and its public anon/publishable key.
# Never put a service-role key here. Production builds fail if either is blank.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
